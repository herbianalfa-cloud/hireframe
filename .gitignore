# Dependencies and build output
node_modules/
dist/
coverage/

# Secrets: never commit env files (only the placeholder template)
.env*
!.env.example

# Functions: deploy bundle (scripts/build-functions.ts) and local emulator secrets
functions/deploy/
functions/.secret.local

# Local scratch output (e.g. scripts/make-cv-fixtures.ts)
/tmp/

# Logs and local tooling
*.log
.firebase/
.DS_Store

# Personal data guard: CVs, documents and data exports stay out of the repo.
# Fake test fixtures and the anonymised eval set are the only exceptions.
*.docx
*.pdf
*.jsonl
!**/fixtures/**
!evals/*.jsonl
