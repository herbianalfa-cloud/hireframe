rules_version = '2';

// Owner-only access (docs/SECURITY.md, ADR-011). The owner UID is read from Firestore
// `config/app` (cross-service rules; the Storage service agent needs
// roles/firebaserules.firestoreServiceAgent, see docs/RUNBOOK.md). Fails closed.
// M1 is read-only; CV upload (M2) opens writes with size/type limits and tests.
// `backups/**` and every other path have no client access (Admin SDK only).
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      let appConfig = /databases/(default)/documents/config/app;
      return request.auth != null
        && firestore.exists(appConfig)
        && request.auth.uid == firestore.get(appConfig).data.get('ownerUid', null);
    }

    match /profile/documents/{allPaths=**} {
      allow read: if isOwner();
    }

    match /cvs/{allPaths=**} {
      allow read: if isOwner();
    }
  }
}
