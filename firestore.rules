rules_version = '2';

// Owner-only access (docs/SECURITY.md, ADR-011).
// - Fails closed: until `config/app` exists with an `ownerUid`, nobody can read or write anything.
// - `config/*` is never writable from a client, so no signed-in user can claim ownership.
// - Client writes are opened one milestone at a time, each with rules tests (tests/rules/).
//   M2 opens fact edits with versioned snapshots (ADR-018) and criteria versions (ADR-019);
//   M2.1 lets the owner mark an upload removed (ADR-023). M3 adds read-only `sources` (ADR-029).
//   M4 lets the owner set their work rights on `profile/main` (ADR-033) and lane points on
//   criteria versions (ADR-034).
//   M6 (Gmail bridge) adds server-only `nonces` and `alertMessages`, denied to every client.
//   M5 lets the owner act on jobs (status, applied stamps, 👍/👎) and append `events` (ADR-038).
//   M7 lets the owner set the CV header on `profile/cvHeader` and mirror Applied onto
//   `applications/{jobId}` beside the job's status change (ADR-055).
//   Everything else, including every write by the Admin SDK paths, stays client-deny.
//   Unknown paths fall through to the default deny.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      let appConfig = /databases/$(database)/documents/config/app;
      return request.auth != null
        && exists(appConfig)
        && request.auth.uid == get(appConfig).data.get('ownerUid', null);
    }

    function hasExactly(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    // ---- Facts (packages/shared/src/profile.ts; limits mirror FACT_LIMITS) ----

    function validFactContent(data) {
      return data.type in ['skill', 'experience', 'achievement', 'metric', 'education', 'project',
                           'constraint', 'preference']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
        && data.evidence is string && data.evidence.size() >= 1 && data.evidence.size() <= 1000
        && data.dates is map && data.dates.keys().hasOnly(['start', 'end'])
        && data.tags is list && data.tags.size() <= 20
        && data.lanes is list && data.lanes.size() <= 4
        && data.lanes.hasOnly(['primary', 'secondary', 'opportunistic', 'wildcard'])
        && data.status in ['active', 'archived']
        // Optional owner-set link (ADR-024): https only, no whitespace, mirrors EvidenceUrlSchema.
        && (!('evidenceUrl' in data)
            || (data.evidenceUrl is string && data.evidenceUrl.size() <= 500
                && data.evidenceUrl.matches('^https://\\S+$')));
    }

    function factPath(profileId, factId) {
      return /databases/$(database)/documents/profile/$(profileId)/facts/$(factId);
    }

    // Every client update is a new version: the content may change, `review` may only be removed
    // (accepting or keeping a proposed change), and the snapshot for the new version must be
    // written in the same batch. Identity fields (source, sourceDocId, createdAt, …) never change.
    function validFactUpdate(profileId, factId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['type', 'text', 'evidence', 'evidenceUrl', 'dates', 'tags', 'lanes',
                              'status', 'review', 'version', 'updatedAt'])
        && after.version == before.version + 1
        && after.updatedAt == request.time
        && validFactContent(after)
        && (!changed.hasAny(['review']) || !('review' in after))
        && existsAfter(/databases/$(database)/documents/profile/$(profileId)/facts/$(factId)/versions/$(string(after.version)));
    }

    // A snapshot is the fact exactly as the same batch leaves it, for the version that batch
    // creates. Versions are immutable (create only).
    function validVersionCreate(profileId, factId, versionId) {
      let data = request.resource.data;
      let factNow = get(factPath(profileId, factId)).data;
      let factAfter = getAfter(factPath(profileId, factId)).data;
      return hasExactly(data, ['snapshot', 'change', 'at'])
        && data.change in ['edit', 'archive', 'unarchive', 'review_accepted', 'review_kept']
        && data.at == request.time
        && factAfter.version == factNow.version + 1
        && versionId == string(factAfter.version)
        && data.snapshot == factAfter
        // Removing a review is exactly what accepting or keeping a proposed change means.
        && (('review' in factNow && !('review' in factAfter))
            == (data.change in ['review_accepted', 'review_kept']));
    }

    // "Remove upload" (ADR-023): the owner may only stamp `removedAt` (and `updatedAt`) with the
    // server time, once, on an upload that finished. Its facts are archived by versioned fact
    // edits in the same or earlier batches; nothing else about the document can change.
    function validDocumentRemoval() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['removedAt', 'updatedAt'])
        && after.diff(before).affectedKeys().hasAll(['removedAt', 'updatedAt'])
        && !('removedAt' in before)
        && before.status in ['parsed', 'failed']
        && after.removedAt == request.time
        && after.updatedAt == request.time;
    }

    // ---- Profile settings (`profile/main`, M4, ADR-033) ----

    // The owner's work rights, with an optional valid-until date (YYYY-MM-DD). Mirrors
    // ProfileSettingsSchema: exactly these keys, server time on every write, createdAt fixed.
    function validProfileSettings() {
      let data = request.resource.data;
      return data.keys().hasAll(['workRights', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.keys().hasOnly(['workRights', 'validUntil', 'createdAt', 'updatedAt',
                                'schemaVersion'])
        && data.workRights in ['unrestricted', 'time_limited', 'needs_sponsorship']
        && (!('validUntil' in data)
            || (data.validUntil is string
                && data.validUntil.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
        && data.updatedAt == request.time
        && data.schemaVersion == 1
        && (resource == null
            ? data.createdAt == request.time
            : data.createdAt == resource.data.createdAt);
    }

    // ---- CV header (`profile/cvHeader`, M7, ADR-055) ----

    function httpsLink(value) {
      return value is string && value.size() <= 200 && value.matches('^https://\\S+$');
    }

    function nonBlank(value, max) {
      return value is string && value.trim().size() >= 1 && value.size() <= max;
    }

    // The contact block code puts on every generated CV. Mirrors CvHeaderSchema: exactly these
    // keys, at most three https links, server time on every write, createdAt fixed. Rules can't
    // loop, so the three link slots are checked by index.
    function validCvHeader() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'location', 'links', 'createdAt',
                                'updatedAt', 'schemaVersion'])
        && nonBlank(data.name, 80)
        && data.email is string && data.email.size() <= 120
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && (!('phone' in data) || nonBlank(data.phone, 40))
        && (!('location' in data) || nonBlank(data.location, 80))
        && (!('links' in data)
            || (data.links is list && data.links.size() <= 3
                && (data.links.size() < 1 || httpsLink(data.links[0]))
                && (data.links.size() < 2 || httpsLink(data.links[1]))
                && (data.links.size() < 3 || httpsLink(data.links[2]))))
        && data.updatedAt == request.time
        && data.schemaVersion == 1
        && (resource == null
            ? data.createdAt == request.time
            : data.createdAt == resource.data.createdAt);
    }

    // ---- Criteria (packages/shared/src/criteria.ts) ----

    function criteriaPointerPath() {
      return /databases/$(database)/documents/criteria/current;
    }

    function validPointerWrite() {
      let data = request.resource.data;
      let expected = resource == null ? 1 : resource.data.version + 1;
      return hasExactly(data, ['version', 'updatedAt', 'schemaVersion'])
        && data.version is int && data.version == expected
        && data.updatedAt == request.time
        && data.schemaVersion == 1
        && existsAfter(/databases/$(database)/documents/criteria/$('v' + string(data.version)));
    }

    function validCriteriaContent(data) {
      return data.lanes is map && hasExactly(data.lanes, ['primary', 'secondary', 'opportunistic'])
        && data.wildcards is list && data.wildcards.size() <= 100
        && data.excluded_titles is list && data.excluded_titles.size() <= 100
        && data.excluded_keywords is list && data.excluded_keywords.size() <= 100
        && data.excluded_companies is list && data.excluded_companies.size() <= 100
        && data.experience_cap_years is int
        && data.experience_cap_years >= 0 && data.experience_cap_years <= 20
        && data.blockers is list && data.blockers.size() <= 100
        && data.locations is map && hasExactly(data.locations, ['preferred', 'accepted'])
        && data.company_prefs is map
        && hasExactly(data.company_prefs, ['size', 'stages', 'sectors_boost', 'sectors_penalise'])
        && data.freshness_days is int && data.freshness_days >= 1 && data.freshness_days <= 90
        && data.thresholds is map
        && hasExactly(data.thresholds, ['apply_fit', 'apply_luck', 'near_miss_fit', 'wildcard_fit'])
        && data.weekly_target is int && data.weekly_target >= 1 && data.weekly_target <= 100
        && validLanePoints(data);
    }

    function validLanePoint(value) {
      return value is number && value >= 0 && value <= 3;
    }

    // Optional (ADR-034): versions saved before M4 don't have it.
    function validLanePoints(data) {
      return !('lane_points' in data)
        || (data.lane_points is map
            && hasExactly(data.lane_points, ['primary', 'secondary', 'opportunistic', 'wildcard'])
            && validLanePoint(data.lane_points.primary)
            && validLanePoint(data.lane_points.secondary)
            && validLanePoint(data.lane_points.opportunistic)
            && validLanePoint(data.lane_points.wildcard));
    }

    // Version n is created together with the pointer moving from n-1 to n.
    function validCriteriaVersionCreate(versionId) {
      let data = request.resource.data;
      let before = exists(criteriaPointerPath()) ? get(criteriaPointerPath()).data.version : 0;
      let after = getAfter(criteriaPointerPath()).data.version;
      return after == before + 1
        && versionId == 'v' + string(after)
        && data.keys().hasAll(['lanes', 'wildcards', 'excluded_titles', 'excluded_keywords',
                               'excluded_companies', 'experience_cap_years', 'blockers',
                               'locations', 'company_prefs', 'freshness_days', 'thresholds',
                               'weekly_target', 'version', 'createdAt', 'schemaVersion'])
        && data.keys().hasOnly(['lanes', 'wildcards', 'excluded_titles', 'excluded_keywords',
                                'excluded_companies', 'experience_cap_years', 'blockers',
                                'locations', 'company_prefs', 'freshness_days', 'thresholds',
                                'weekly_target', 'lane_points', 'version', 'createdAt',
                                'schemaVersion'])
        && data.version == after
        && data.createdAt == request.time
        && data.schemaVersion == 1
        && validCriteriaContent(data);
    }

    // ---- Jobs and events (M5, ADR-038) ----

    function jobPath(jobId) {
      return /databases/$(database)/documents/jobs/$(jobId);
    }

    // The owner may change only `status`, `appliedAt`, `appliedVerdict`, `feedback` and
    // `updatedAt`. Funnel and ingest fields are server-written. A status change is between the
    // four client statuses; applied stamps `appliedAt` with the server time and the job's own
    // verdict, and leaving applied clears both. A rating names the verdict it judged, so one
    // written after a re-score changed the verdict is rejected.
    function validJobAction() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['status', 'appliedAt', 'appliedVerdict', 'feedback', 'updatedAt'])
        && changed.hasAny(['status', 'feedback'])
        && after.updatedAt == request.time
        && (!changed.hasAny(['status', 'appliedAt', 'appliedVerdict'])
            || validStatusChange(before, after))
        && (!changed.hasAny(['feedback'])
            || ('feedback' in after
                ? validFeedback(before, after.feedback)
                : validFeedbackRemoval(before, changed)));
    }

    // Un-rate (ADR-038): the owner may delete the whole `feedback` field, together with
    // `updatedAt` and nothing else, and only when there is a rating to remove.
    function validFeedbackRemoval(before, changed) {
      return 'feedback' in before
        && changed.hasAll(['feedback', 'updatedAt'])
        && changed.hasOnly(['feedback', 'updatedAt']);
    }

    function validStatusChange(before, after) {
      let clientStatuses = ['new', 'saved', 'applied', 'skipped'];
      return before.status in clientStatuses
        && after.status in clientStatuses
        && after.status != before.status
        && (after.status == 'applied'
            ? after.appliedAt == request.time
              && (before.get('verdict', null) == null
                  ? !('appliedVerdict' in after)
                  : after.get('appliedVerdict', null) == before.verdict)
            : !('appliedAt' in after) && !('appliedVerdict' in after));
    }

    function validFeedback(before, feedback) {
      return feedback is map
        && feedback.keys().hasAll(['agree', 'verdict', 'at'])
        && feedback.keys().hasOnly(['agree', 'note', 'verdict', 'expected', 'at'])
        && feedback.agree is bool
        && before.get('verdict', null) != null
        && feedback.verdict == before.verdict
        && feedback.at == request.time
        && (!('note' in feedback)
            || (feedback.note is string && feedback.note.trim().size() >= 1
                && feedback.note.size() <= 280))
        && (!('expected' in feedback)
            || (feedback.expected in ['apply', 'near_miss', 'wildcard', 'skip']
                && feedback.expected != feedback.verdict
                && feedback.agree == false));
    }

    // Events are created in the same batch as the job change they record, and never edited.
    function validEventCreate() {
      let data = request.resource.data;
      let verdicts = ['apply', 'near_miss', 'wildcard', 'skip'];
      return data.get('jobId', null) is string
        && data.jobId.size() >= 1 && data.jobId.size() <= 200
        && data.at == request.time
        && data.schemaVersion == 1
        && existsAfter(jobPath(data.jobId))
        && (data.get('type', null) == 'job_status'
            ? data.keys().hasAll(['type', 'jobId', 'from', 'to', 'at', 'schemaVersion'])
              && data.keys().hasOnly(['type', 'jobId', 'from', 'to', 'verdict', 'at',
                                      'schemaVersion'])
              && data.from in ['new', 'saved', 'applied', 'skipped', 'interview', 'offer',
                               'rejected']
              && data.to in ['new', 'saved', 'applied', 'skipped']
              && data.from != data.to
              && get(jobPath(data.jobId)).data.status == data.from
              && getAfter(jobPath(data.jobId)).data.status == data.to
              && getAfter(jobPath(data.jobId)).data.updatedAt == request.time
              && (get(jobPath(data.jobId)).data.get('verdict', null) == null
                  ? !('verdict' in data)
                  : data.get('verdict', null) == get(jobPath(data.jobId)).data.verdict)
            : data.get('type', null) == 'job_feedback'
              ? data.keys().hasAll(['type', 'jobId', 'agree', 'verdict', 'at', 'schemaVersion'])
                && data.keys().hasOnly(['type', 'jobId', 'agree', 'verdict', 'expected', 'at',
                                        'schemaVersion'])
                && data.agree is bool
                && data.verdict in verdicts
                && (!('expected' in data) || (data.expected in verdicts && !data.agree))
                && getAfter(jobPath(data.jobId)).data.updatedAt == request.time
                && getAfter(jobPath(data.jobId)).data.feedback.at == request.time
                && getAfter(jobPath(data.jobId)).data.feedback.agree == data.agree
                && getAfter(jobPath(data.jobId)).data.feedback.verdict == data.verdict
                && getAfter(jobPath(data.jobId)).data.feedback.get('expected', null)
                   == data.get('expected', null)
              : data.get('type', null) == 'job_feedback_removed'
                // The event names the rating the job had and the batch removes.
                ? data.keys().hasOnly(['type', 'jobId', 'agree', 'verdict', 'at', 'schemaVersion'])
                  && data.keys().hasAll(['type', 'jobId', 'agree', 'verdict', 'at', 'schemaVersion'])
                  && data.agree is bool
                  && data.verdict in verdicts
                  && getAfter(jobPath(data.jobId)).data.updatedAt == request.time
                  && !('feedback' in getAfter(jobPath(data.jobId)).data)
                  && get(jobPath(data.jobId)).data.get('feedback', null) != null
                  && get(jobPath(data.jobId)).data.feedback.agree == data.agree
                  && get(jobPath(data.jobId)).data.feedback.verdict == data.verdict
                : false);
    }

    match /config/{docId} {
      allow read: if isOwner();
      allow write: if false; // Admin SDK / console only.
    }

    match /criteria/current {
      allow read: if isOwner();
      allow create, update: if isOwner() && validPointerWrite();
    }

    // `current` also matches here; overlapping matches are OR'd, so the guard keeps the
    // version rules from ever applying to the pointer.
    match /criteria/{versionId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && versionId != 'current'
        && versionId.matches('^v[1-9][0-9]*$')
        && existsAfter(criteriaPointerPath())
        && validCriteriaVersionCreate(versionId);
    }

    match /profile/{profileId} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && ((profileId == 'main' && validProfileSettings())
            || (profileId == 'cvHeader' && validCvHeader()));

      match /facts/{factId} {
        allow read: if isOwner();
        allow update: if isOwner() && profileId == 'main' && validFactUpdate(profileId, factId);

        match /versions/{versionId} {
          allow read: if isOwner();
          allow create: if isOwner()
            && profileId == 'main'
            && existsAfter(factPath(profileId, factId))
            && validVersionCreate(profileId, factId, versionId);
        }
      }

      match /documents/{docId} {
        allow read: if isOwner();
        allow update: if isOwner() && profileId == 'main' && validDocumentRemoval();
      }
    }

    // The Applied mirror (M7, ADR-055). The stage machine is server-side; the one move a client
    // makes is Mark applied and its undo, in the same batch as the job's status change. Only
    // `stage`, `stageBefore` and `updatedAt` may change. Applied needs the job to become applied
    // in this batch and remembers where it came from; leaving it goes back to exactly that stage,
    // with the job no longer applied. A client never writes stage `generating` (that is the
    // worker's): Mark applied is refused from it, and Undo is refused back into it.
    function validApplicationMirror(jobId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let jobBefore = get(jobPath(jobId)).data;
      let jobAfter = getAfter(jobPath(jobId)).data;
      return changed.hasOnly(['stage', 'stageBefore', 'updatedAt'])
        && changed.hasAll(['stage', 'updatedAt'])
        && after.updatedAt == request.time
        && (after.stage == 'applied'
            ? before.stage in ['chosen', 'needs_input', 'ready']
              && after.get('stageBefore', null) == before.stage
              && jobBefore.status != 'applied'
              && jobAfter.status == 'applied'
            : before.stage == 'applied'
              && after.stage == before.get('stageBefore', null)
              && after.stage != 'generating'
              && !('stageBefore' in after)
              && jobBefore.status == 'applied'
              && jobAfter.status != 'applied');
    }

    match /companies/{companyId} {
      allow read: if isOwner();
    }

    match /jobs/{jobId} {
      allow read: if isOwner();
      allow update: if isOwner() && validJobAction();

      match /description/{descId} {
        allow read: if isOwner();
      }
    }

    match /applications/{jobId} {
      allow read: if isOwner();
      allow update: if isOwner() && validApplicationMirror(jobId);
    }

    match /cvs/{cvId} {
      allow read: if isOwner();
    }

    match /runs/{runId} {
      allow read: if isOwner();
    }

    match /usage/{month} {
      allow read: if isOwner();
    }

    match /events/{eventId} {
      allow read: if isOwner();
      allow create: if isOwner() && validEventCreate();
    }

    match /locks/{lockId} {
      allow read: if isOwner();
    }

    // Source health for the System screen (ADR-029); written by the Admin SDK only. `email` is
    // the Gmail bridge's (ADR-047).
    match /sources/{sourceId} {
      allow read: if isOwner();
    }

    // Server-only (ADR-046, ADR-047): signed-request nonces and ingested-alert records. Default
    // deny already covers them; stated so no later wildcard can open them by accident.
    match /nonces/{nonce} {
      allow read, write: if false;
    }

    match /alertMessages/{hash} {
      allow read, write: if false;
    }
  }
}
