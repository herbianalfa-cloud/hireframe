# Fail closed: no commit without a secret scan (CLAUDE.md hard rule, docs/SECURITY.md).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the commit is blocked." >&2
  echo "Install it with: brew install gitleaks" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
